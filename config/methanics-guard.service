# /etc/systemd/system/methanics-guard.service (root)
# 부팅마다 사용자 세션이 열리기 전에 앱 자동 시작 유닛(~/.config/systemd/user/methanics-*)이 비었거나
# mask 되었으면 원본(/opt/methanics/units)으로 복구한다. 전원 급차단 뒤 0바이트 파일 대비.
[Unit]
Description=Methanics HMI autostart guard (repair user units before login)
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=oneshot
ExecStart=/opt/methanics/bin/methanics-guard
StandardOutput=journal
SyslogIdentifier=methanics-guard

[Install]
WantedBy=multi-user.target
